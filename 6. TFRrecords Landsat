# ==========================================
# BUILD TFRRECORDS — LANDSAT MS ONLY
# ==========================================

import tensorflow as tf
import numpy as np
import rasterio, os, re
from pathlib import Path
from tqdm import tqdm

BASE_DIR = Path("/content/drive/MyDrive")
TFR_OUT  = BASE_DIR / "tfrecords_ms_y19"
TFR_OUT.mkdir(parents=True, exist_ok=True)

WINDOWS  = ["2006-2008", "2012-2014", "2022-2024"]
MS_BANDS = ["BLUE","GREEN","RED","NIR","SWIR1","SWIR2","TEMP"]

def _float_feature(v):  return tf.train.Feature(float_list=tf.train.FloatList(value=v))
def _bytes_feature(v):  return tf.train.Feature(bytes_list=tf.train.BytesList(value=[v.encode()]))

def read_tiff(path):
    with rasterio.open(path) as src:
        arr = src.read().astype(np.float32)  # (bands,H,W)
    arr = np.transpose(arr, (1,2,0))         # -> (H,W,bands)
    if np.any(np.isnan(arr)): arr = np.nan_to_num(arr, nan=0.0)
    return arr

def example_from_chip(uid, win, img):
    img_raw = img.ravel().tolist()
    feat = {
        "uid":    _bytes_feature(uid),
        "window": _bytes_feature(win),
        "image":  _float_feature(img_raw),
        "height": _float_feature([img.shape[0]]),
        "width":  _float_feature([img.shape[1]]),
        "bands":  _float_feature([img.shape[2]]),
    }
    return tf.train.Example(features=tf.train.Features(feature=feat))

def resolve_ms_folder(win: str) -> Path | None:
    # 1) exact standard name
    p = BASE_DIR / f"drc_ms_chips_y19_{win}"
    if p.exists(): return p
    # 2) search for folders matching pattern
    pat = re.compile(rf"drc_ms_chips_y19.*{re.escape(win)}", flags=re.IGNORECASE)
    candidates = [BASE_DIR / d for d in os.listdir(BASE_DIR) if pat.fullmatch(d)]
    for c in candidates:
        if c.exists(): return c
    return None

for win in WINDOWS:
    ms_folder = resolve_ms_folder(win)
    if ms_folder is None:
        print(f"{win}: could not find folder under {BASE_DIR}. Examples available:",
              [d for d in os.listdir(BASE_DIR) if d.startswith("drc_ms_chips_y19")])
        continue

    files = sorted(ms_folder.glob(f"ms_{win}_*.tif"))
    print(f"{win}: folder={ms_folder.name} · TIFFs={len(files)}")
    if len(files) == 0:
        print(f"{win}: no files ms_{win}_*.tif in {ms_folder}")
        continue

    out_path = TFR_OUT / f"landsat_{win}.tfrecord"
    with tf.io.TFRecordWriter(str(out_path)) as writer:
        for f in tqdm(files, desc=f"Writing {win}"):
            uid = f.stem.split("_")[-1]
            try:
                img = read_tiff(f)
            except Exception as e:
                print(f"{win} · {uid}: read error: {e}")
                continue
            ex = example_from_chip(uid, win, img)
            writer.write(ex.SerializeToString())

    print(f"{win}: TFRecord → {out_path}")
