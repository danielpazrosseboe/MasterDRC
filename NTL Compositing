# ======================================================
# Cell 3 — Night-lights compositing (DMSP + VIIRS, 3y)
# ======================================================
# DMSP annual (1992–2013): NOAA/DMSP-OLS/NIGHTTIME_LIGHTS, band 'stable_lights'
# VIIRS monthly (2012–):  NOAA/VIIRS/DNB/MONTHLY_V1/VCMSLCFG, band 'avg_rad'
def dmsp_3yr(window_label, geom):
    s, e = get_window_dates(window_label)
    # clamp to sensor availability
    sY = ee.Number(ee.Date(s).get("year")).max(1992)
    eY = ee.Number(ee.Date(e).get("year")).min(2013)
    has = sY.lte(eY)
    img = ee.Image(ee.Algorithms.If(
        has,
        (ee.ImageCollection("NOAA/DMSP-OLS/NIGHTTIME_LIGHTS")
           .filter(ee.Filter.calendarRange(sY, eY, "year"))
           .filterBounds(geom)
           .select("stable_lights")
           .median()
           .toFloat()
           .rename("DMSP")),
        ee.Image.constant(0).rename("DMSP").toFloat()
    ))
    return img

def viirs_3yr(window_label, geom):
    s, e = get_window_dates(window_label)
    # clamp to sensor availability
    s2 = ee.Date(ee.Algorithms.If(ee.Date(s).millis().lt(ee.Date("2012-01-01").millis()),
                                  "2012-01-01", s))
    has = ee.Date(s2).millis().lte(ee.Date(e).millis())
    img = ee.Image(ee.Algorithms.If(
        has,
        (ee.ImageCollection("NOAA/VIIRS/DNB/MONTHLY_V1/VCMSLCFG")
           .filterDate(s2, e)
           .filterBounds(geom)
           .select("avg_rad")
           .median()
           .toFloat()
           .rename("VIIRS")),
        ee.Image.constant(0).rename("VIIRS").toFloat()
    ))
    return img

def nightlights_composite(window_label, geom):
    """Return a 2-band image [DMSP, VIIRS] with zero-fill where unavailable."""
    dm = dmsp_3yr(window_label, geom)
    vv = viirs_3yr(window_label, geom)
    return dm.addBands(vv).select(NL_BANDS)
