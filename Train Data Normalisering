# ==========================================
# Beregn per-bånd mean/std fra TRAIN og lagre norm_ms.json
# ==========================================
import tensorflow as tf, numpy as np, json, os
import pandas as pd
from pathlib import Path

BASE    = Path("/content/drive/MyDrive")
OUTDIR  = BASE / "manifests_ms"; OUTDIR.mkdir(parents=True, exist_ok=True)
MAN     = pd.read_csv(OUTDIR / "manifest_ms_split_merged.csv")

# TFRecords: kun TRAIN
tfr_paths = sorted(p for p in MAN.loc[MAN.split=="train","tfrecord"].dropna().unique() if os.path.exists(p))
assert tfr_paths, "Ingen TFRecords funnet for split=='train'."

# Konstanter
H,W,C = 255,255,7
CROP  = 224
PAD   = (H - CROP)//2
OUT_JSON = OUTDIR / "norm_ms.json"

# TFRecord-skjema
FEATURES = {
    "uid":    tf.io.FixedLenFeature([], tf.string),
    "window": tf.io.FixedLenFeature([], tf.string),
    "image":  tf.io.FixedLenFeature([H*W*C], tf.float32),
}

def _parse(ex):
    ex  = tf.io.parse_single_example(ex, FEATURES)
    img = tf.reshape(ex["image"], [H,W,C])
    img = img[PAD:PAD+CROP, PAD:PAD+CROP, :]  # 255→224, samsvar med treningsinput
    return img

ds = (tf.data.TFRecordDataset(tfr_paths, num_parallel_reads=tf.data.AUTOTUNE)
        .map(_parse, num_parallel_calls=tf.data.AUTOTUNE)
        .batch(16)
        .prefetch(tf.data.AUTOTUNE))

# Løpende statistikk (ignorer null-fyll)
sum_   = np.zeros(C, np.float64)
sumsq  = np.zeros(C, np.float64)
count  = np.zeros(C, np.int64)
vmin   = np.full(C, np.inf, np.float64)
vmax   = np.full(C, -np.inf, np.float64)

for batch in ds:
    x = batch.numpy()                    # (N,224,224,7)
    n,h,w,_ = x.shape
    X = x.reshape(n*h*w, C)              # (pixels, C)
    nz = X != 0.0                        # maske for ikke-null

    # min/max på ikke-null
    for c in range(C):
        if nz[:,c].any():
            xc = X[nz[:,c], c]
            vmin[c] = min(vmin[c], float(xc.min()))
            vmax[c] = max(vmax[c], float(xc.max()))

    # sum/sum^2 og telling
    Xn = np.where(nz, X, 0.0)
    sum_  += Xn.sum(axis=0, dtype=np.float64)
    sumsq += (Xn**2).sum(axis=0, dtype=np.float64)
    count += nz.sum(axis=0, dtype=np.int64)

# Mean/std
mean = np.zeros(C, np.float64)
std  = np.ones(C,  np.float64)
for c in range(C):
    if count[c] > 0:
        mean[c] = sum_[c] / count[c]
        var = max(sumsq[c] / count[c] - mean[c]**2, 0.0)
        std[c]  = np.sqrt(var)
    else:
        mean[c] = 0.0; std[c] = 1.0

stats = {
    "bands": ["BLUE","GREEN","RED","NIR","SWIR1","SWIR2","TEMP"],
    "count": count.tolist(),
    "min":   vmin.tolist(),
    "max":   vmax.tolist(),
    "mean":  mean.tolist(),
    "std":   std.tolist(),
}

with open(OUT_JSON, "w") as f:
    json.dump(stats, f, indent=2)

print("Skrev:", OUT_JSON)
print("mean[:3] =", np.round(mean[:3], 6), " std[:3] =", np.round(std[:3], 6))
