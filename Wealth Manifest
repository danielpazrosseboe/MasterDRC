# ==========================================
# MERGE WEALTH — behold kun nødvendige kolonner + oppdater TFR-stier (fixed)
# ==========================================
import pandas as pd, os
from pathlib import Path

BASE    = Path("/content/drive/MyDrive")
OUTDIR  = BASE / "manifests_ms"
OUTDIR.mkdir(exist_ok=True)

MAN_SPLIT  = OUTDIR / "manifest_ms_split.csv"
WEALTH_CSV = BASE / "Master_Thesis/outputs/dhs_cluster_wealth.csv"
TFR_DIR_OLD   = BASE / "tfrecords_ms_y19"
TFR_DIR_FIXED = BASE / "tfrecords_ms_y19_fixed"  # nye TFRecords med riktig uid/window
OUT_PATH  = OUTDIR / "manifest_ms_split_merged.csv"

assert MAN_SPLIT.exists(), f"Mangler manifest: {MAN_SPLIT}"
assert WEALTH_CSV.exists(), f"Mangler wealth CSV: {WEALTH_CSV}"

# --- Les og normaliser kolonnenavn ---
m = pd.read_csv(MAN_SPLIT)
m.columns = [c.strip().lower() for c in m.columns]
for need in ["uid","window","tfrecord","split"]:
    if need not in m.columns:
        raise ValueError(f"Mangler kolonne i manifest: {need}")

# --- Oppdater TFRecord-stier til 'tfrecords_ms_y19_fixed' hvis finnes ---
def map_tfr(win: str) -> str:
    new_p = TFR_DIR_FIXED / f"landsat_{win}.tfrecord"
    old_p = TFR_DIR_OLD   / f"landsat_{win}.tfrecord"
    if new_p.exists(): return str(new_p)
    if old_p.exists(): return str(old_p)
    # fallback til eksisterende verdi i manifest
    return None

m["window"] = m["window"].astype(str).str.strip()
mapped = m["window"].map(map_tfr)
# bare erstatt dersom vi faktisk fant en fil
m.loc[mapped.notna(), "tfrecord"] = mapped[mapped.notna()].values

# --- Parse cluster_id fra uid i manifestet (format: '<id>_<window>') ---
def parse_cluster(u):
    try:
        base = str(u).split("_")[0]
        return int(float(base))
    except Exception:
        return pd.NA

m["cluster_id_int"] = m["uid"].astype(str).apply(parse_cluster)

# --- Les wealth og normaliser ---
w = pd.read_csv(WEALTH_CSV)
w.columns = [c.strip().lower() for c in w.columns]
if "wealth_std" not in w.columns or "cluster_id" not in w.columns or "window" not in w.columns:
    raise ValueError("Wealth CSV må ha kolonnene: cluster_id, window, wealth_std")
w = w.rename(columns={"wealth_std": "wealth"})

# Map wealth-vinduer til 3-års vinduer brukt i manifestet
win_map = {"2007":"2006-2008", "2013-2014":"2012-2014", "2023-2024":"2022-2024"}
w["window3"] = w["window"].astype(str).map(win_map).fillna(w["window"].astype(str))

# --- Merge: venstreslå m mot w på (cluster_id, window) ---
merged = m.merge(
    w[["cluster_id", "window3", "wealth"]],
    left_on=["cluster_id_int", "window"],
    right_on=["cluster_id", "window3"],
    how="left"
)

# --- Velg KUN nødvendige kolonner ---
keep = ["uid", "window", "tfrecord", "split", "wealth"]
out = merged[keep].copy()

# --- Rydd duplikater og trims ---
out = out.drop_duplicates(subset=["uid","window"], keep="first").reset_index(drop=True)
out["tfrecord"] = out["tfrecord"].astype(str).str.strip()

# --- Valider at TFR-filer finnes per split ---
def _exists(p): return os.path.exists(p) if isinstance(p, str) else False
missing = sorted({p for p in out["tfrecord"].unique() if not _exists(p)})
if missing:
    print("⚠️ Mangler TFRecord-filer:")
    for p in missing: print("   ", p)

# --- Lagre + diagnose ---
out.to_csv(OUT_PATH, index=False)
print("Skrev:", OUT_PATH)
print("\nPer split: rader og wealth!=NA")
print(out.assign(has_wealth=out["wealth"].notna()).groupby("split")["has_wealth"].agg(["count","sum"]))
