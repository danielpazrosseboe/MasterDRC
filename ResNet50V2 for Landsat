# ==========================================
# ResNet50V2 for 7-kanals Landsat (224×224)
#  - 1×1 projeksjon 7→3 inn i ImageNet-ResNet50V2
#  - Frys tidlige blokker (trener conv4+conv5)
#  - MSE-tap, MSE og RMSE som metrikker
#  - Train + eval i én celle
# Forutsetter at train_ds, val_ds, test_ds allerede eksisterer.
# ==========================================
import tensorflow as tf
import numpy as np
from pathlib import Path

def build_resnet50v2_7ch_proj(input_shape=(224, 224, 7), freeze_upto="conv4_block1_out"):
    inp = tf.keras.Input(shape=input_shape, name="ms7_input")

    # 7→3 projeksjon med konstant init: kopier BLUE,GREEN,RED → RGB. Andre bånd starter som 0.
    w = np.zeros((1, 1, 7, 3), dtype=np.float32)
    w[0, 0, 0, 0] = 1.0  # BLUE  -> R
    w[0, 0, 1, 1] = 1.0  # GREEN -> G
    w[0, 0, 2, 2] = 1.0  # RED   -> B
    proj = tf.keras.layers.Conv2D(
        3, 1, use_bias=False, name="band_proj_7to3",
        kernel_initializer=tf.keras.initializers.Constant(w)
    )(inp)

    # ImageNet-basemodell på 3 kanaler. Laster interne vekter problemfritt.
    base = tf.keras.applications.ResNet50V2(
        include_top=False, weights="imagenet", input_shape=(224, 224, 3), pooling="avg"
    )

    # Frys tidlig, tren sent: alt før 'freeze_upto' fryses, resten trenes
    trainable = False
    for l in base.layers:
        if l.name == freeze_upto:
            trainable = True
        l.trainable = trainable

    x = base(proj)
    out = tf.keras.layers.Dense(1, name="regressor")(x)
    model = tf.keras.Model(inp, out, name="resnet50v2_ms7_proj")
    return model

# ---- bygg modell ----
model = build_resnet50v2_7ch_proj()

# ---- optimizer + compile ----
opt = tf.keras.optimizers.Adam(learning_rate=3e-4)
model.compile(
    optimizer=opt,
    loss="mse",
    metrics=[tf.keras.metrics.MeanSquaredError(name="mse"),
             tf.keras.metrics.RootMeanSquaredError(name="rmse")]
)

