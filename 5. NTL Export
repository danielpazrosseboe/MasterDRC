-# ==========================================
# FAST NTL EXPORT — per-period folders, 20→5→1 backoff
# ==========================================
import ee, time

# ---- Config ----
NL_BANDS = ["DMSP","VIIRS"]   # adjust if your composite uses different names
MS_BANDS = ["BLUE","GREEN","RED","NIR","SWIR1","SWIR2","TEMP"]  # for coverage gating
SCALE_M  = 30
CHIP_PIX = 255
COVERAGE_THRESHOLD = 0.50
EXPORT_DIMS = f"{CHIP_PIX}x{CHIP_PIX}"
THROTTLE_SECONDS = 0.35

DRIVE_NL_BASE = "drc_nl_chips_y19"
def drive_folder_for(win):  # per-period subfolders
    return f"{DRIVE_NL_BASE}_{win}"

WINDOWS_TO_RUN = ["2006-2008","2012-2014","2022-2024"]
START_AT_IDX   = {"2006-2008":0, "2012-2014":0, "2022-2024":0}

# ---- FC helpers ----
def add_xy(f):
    c = f.geometry().centroid(1).coordinates()
    return f.set({"lon": c.get(0), "lat": c.get(1)})

def drop_zero_zero(fc):
    return fc.map(add_xy).filter(ee.Filter.Or(ee.Filter.neq("lon", 0), ee.Filter.neq("lat", 0)))

def dedupe_by_xy(fc, decimals=5):
    def _round(v): return ee.Number(v).format(f"%.{decimals}f")
    def _with_key(f):
        c = f.geometry().centroid(1).coordinates()
        k = ee.String(_round(c.get(0))).cat("_").cat(_round(c.get(1)))
        return f.set({"xy_key": k})
    return fc.map(_with_key).distinct(["xy_key"])

def with_window_and_uid(fc, window_label):
    def _tag(f):
        has_uid = f.propertyNames().contains("uid")
        def _make_uid():
            cid = ee.Algorithms.If(f.propertyNames().contains("cluster_id"), f.get("cluster_id"),
                  ee.Algorithms.If(f.propertyNames().contains("DHSCLUST"), f.get("DHSCLUST"),
                  ee.Algorithms.If(f.propertyNames().contains("hv001"),     f.get("hv001"),
                                    ee.String("noid_").cat(ee.String(f.id())))))
            return ee.String(cid).cat("_").cat(window_label)
        uid = ee.String(ee.Algorithms.If(has_uid, f.get("uid"), _make_uid()))
        return f.set({"window": window_label, "uid": uid})
    return fc.map(_tag)

def chip_square(point):
    half_m = (CHIP_PIX * SCALE_M) / 2.0
    return ee.Geometry(point).buffer(half_m).bounds()

# ---- Load DHS FeatureCollections ----
C07 = dedupe_by_xy(drop_zero_zero(ee.FeatureCollection("users/pazern10/2007")))
C13 = dedupe_by_xy(drop_zero_zero(ee.FeatureCollection("users/pazern10/2013-14")))
C23 = dedupe_by_xy(drop_zero_zero(ee.FeatureCollection("users/pazern10/2023-24")))

FC_BY_WINDOW = {
    "2006-2008": with_window_and_uid(C07, "2006-2008"),
    "2012-2014": with_window_and_uid(C13, "2012-2014"),
    "2022-2024": with_window_and_uid(C23, "2022-2024"),
}

# ---- Coverage annotation ----
def annotate_cov_ms(win, fc_slice):
    def _mark(f):
        pt   = f.geometry().centroid(1)
        chip = chip_square(pt)
        ms   = landsat_ms_composite(win, chip)
        v = ms.select(MS_BANDS).mask().reduce(ee.Reducer.min())
        vsum = ee.Number(v.unmask(0).reduceRegion(
            reducer=ee.Reducer.sum(), geometry=chip, scale=SCALE_M,
            maxPixels=1e8, bestEffort=True).get("min", 0))
        cnt  = ee.Number(ee.Image.constant(1).reduceRegion(
            reducer=ee.Reducer.count(), geometry=chip, scale=SCALE_M,
            maxPixels=1e8, bestEffort=True).get("constant", 0))
        frac = ee.Number(ee.Algorithms.If(cnt.gt(0), vsum.divide(cnt), 0))
        return f.set({"valid_frac": frac})
    return fc_slice.map(_mark)

# ---- Export one feature ----
def export_nl(win, feat):
    uid  = ee.String(feat.get("uid")).getInfo() 
    chip = chip_square(feat.geometry().centroid(1))
    img  = nightlights_composite(win, chip).select(NL_BANDS).clip(chip).toFloat()
    desc = f"nl_{win}_{uid}"
    ee.batch.Export.image.toDrive(
        image=img,
        description=desc,
        folder=drive_folder_for(win),   # per-period folder
        fileNamePrefix=desc,
        region=chip,
        crs="EPSG:4326",
        dimensions=EXPORT_DIMS,
        maxPixels=1e13
    ).start()

# ---- Slice export----
def _export_slice(win, base, start, limit, quiet=False):
    slice_fc = ee.FeatureCollection(base.toList(limit, start))
    keep = annotate_cov_ms(win, slice_fc).filter(ee.Filter.gte("valid_frac", COVERAGE_THRESHOLD))
    n_keep = keep.size().getInfo()
    if not quiet:
        print(f"{win} [{start}:{start+limit}) — eligible {n_keep}")
    if n_keep == 0:
        return
    feats = keep.toList(n_keep)
    for i in range(n_keep):
        f = ee.Feature(feats.get(i))
        export_nl(win, f)
        if ((i+1) % 50) == 0 and not quiet:
            print(f"  started {i+1} tasks…")
        time.sleep(THROTTLE_SECONDS)

def export_window_fast_nl(win, start_at=0, batch=20):
    if win not in FC_BY_WINDOW:
        print(f"{win}: no FC."); return
    base = FC_BY_WINDOW[win]
    n_total = base.size().getInfo()
    print(f"\n{win}: total={n_total} → folder={drive_folder_for(win)}")
    idx = start_at
    while idx < n_total:
        try:
            _export_slice(win, base, idx, batch)
            idx += batch
        except ee.EEException:
            # Subdivide only the failing span
            five_failed = []
            for s5 in range(idx, min(idx+batch, n_total), 5):
                try:
                    _export_slice(win, base, s5, 5, quiet=True)
                except ee.EEException:
                    five_failed.append(s5)
            for s5 in five_failed:
                for s1 in range(s5, min(s5+5, n_total)):
                    try:
                        _export_slice(win, base, s1, 1, quiet=True)
                    except ee.EEException:
                        print(f"  · hard-skip index {s1}")
    print(f"{win}: submitted.")

# ---- Run ----
for _win in WINDOWS_TO_RUN:
    export_window_fast_nl(_win, start_at=START_AT_IDX.get(_win, 0), batch=20)

print("\n✅ Submitted NTL exports with per-period folders and targeted 20→5→1 backoff.")
