# ===========================================
# Cell 2 — Landsat MS compositing (7-band SR)
# ===========================================
# Landsat Collection 2 Level-2 scale factors:
#   SR: reflectance = SR * 0.0000275 + -0.2
#   ST: brightness temp (Kelvin) = ST * 0.00341802 + 149.0
def _mask_l2(img):
    qa = img.select("QA_PIXEL")
    mask = (qa.bitwiseAnd(1<<3).eq(0)  # cloud shadow
            .And(qa.bitwiseAnd(1<<4).eq(0))  # snow
            .And(qa.bitwiseAnd(1<<5).eq(0))) # cloud
    return img.updateMask(mask)

def _scale_L57(img):
    sr = img.select(["SR_B1","SR_B2","SR_B3","SR_B4","SR_B5","SR_B7"]).multiply(0.0000275).add(-0.2)
    st = img.select("ST_B6").multiply(0.00341802).add(149.0)
    return (sr.rename(["BLUE","GREEN","RED","NIR","SWIR1","SWIR2"])
              .addBands(st.rename("TEMP")))

def _scale_L89(img):
    sr = img.select(["SR_B2","SR_B3","SR_B4","SR_B5","SR_B6","SR_B7"]).multiply(0.0000275).add(-0.2)
    st = img.select("ST_B10").multiply(0.00341802).add(149.0)
    return (sr.rename(["BLUE","GREEN","RED","NIR","SWIR1","SWIR2"])
              .addBands(st.rename("TEMP")))

def _prep(col_id, s, e, scaler, geom):
    return (ee.ImageCollection(col_id)
            .filterDate(s, e)
            .filterBounds(geom)
            .map(_mask_l2)
            .map(scaler))

def landsat_ms_composite(window_label, geom, smooth=True):
    """Return 3-year median composite with 7 MS bands for the window and geometry."""
    s, e = get_window_dates(window_label)
    # Collections (the date filter will effectively pick the right missions per window)
    l5 = _prep("LANDSAT/LT05/C02/T1_L2", s, e, _scale_L57, geom)
    l7 = _prep("LANDSAT/LE07/C02/T1_L2", s, e, _scale_L57, geom)
    l8 = _prep("LANDSAT/LC08/C02/T1_L2", s, e, _scale_L89, geom)
    l9 = _prep("LANDSAT/LC09/C02/T1_L2", s, e, _scale_L89, geom)

    img = l5.merge(l7).merge(l8).merge(l9).median()
    if smooth:
        img = img.unmask().focal_median(kernel=ee.Kernel.square(1))
    return img.select(MS_BANDS)
