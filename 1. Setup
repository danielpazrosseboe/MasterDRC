# Build one large clusters CSV after HR↔GE merge-by-cluster, with robust local PCA per file
# and removal of near-zero coordinates.

!pip -q install geopandas pyreadstat

import os, re, glob
import numpy as np
import pandas as pd
import geopandas as gpd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA

# ----------------- PATHS -----------------
BASE       = "/content/drive/My Drive/Master_Thesis/Surveys"
OUT_PATH   = os.path.join(BASE, "clusters_yeh_spec.csv")

# --------------- HELPERS -----------------
def parse_cc_round(name):
    b = os.path.basename(name)
    m_cc = re.match(r"^([A-Z]{2})", b)
    cc = m_cc.group(1) if m_cc else None
    m_r = re.search(r"(HR|GE)(\d)", b)
    rnd = m_r.group(2) if m_r else None
    return cc, rnd

def pick_largest(paths):
    return max(paths, key=os.path.getsize) if paths else None

def to_num(s):
    return pd.to_numeric(s, errors="coerce")

ASSET_MAP = {
    "rooms":       ["hv216","hv217"],
    "electricity": ["hv206"],
    "floor":       ["hv213","hv213a"],
    "water":       ["hv201"],
    "toilet":      ["hv205","hv204"],
    "phone":       ["hv221","hv243a"],
    "radio":       ["hv207"],
    "tv":          ["hv208"],
    "car":         ["hv212"],
    "motorbike":   ["hv211"],
}
ASSET_CANON = list(ASSET_MAP.keys())

LAT_CANDS = ["LATNUM","latnum","LATNUM_C","DHSLAT","LATITUDE","Latitude","latitude","Y","y"]
LON_CANDS = ["LONGNUM","longnum","LONGNUM_C","DHSLONG","LONGITUDE","Longitude","longitude","X","x"]

def pick_first_present(cols, cands):
    for c in cands:
        if c in cols:
            return c
    return None

def add_canonical_assets(df):
    out = {}
    for outcol, cands in ASSET_MAP.items():
        col = None
        for c in cands:
            if c in df.columns:
                col = pd.to_numeric(df[c], errors="coerce")
                break
        out[outcol] = col if col is not None else pd.Series(np.nan, index=df.index, dtype="float32")
    return pd.DataFrame(out)

def binarize_ownership(df_assets):
    for col in ["electricity","phone","radio","tv","car","motorbike"]:
        s = pd.to_numeric(df_assets[col], errors="coerce")
        if s.dropna().isin([1,2]).all():
            df_assets[col] = s.map({1:1, 2:0}).astype("float32")
        else:
            df_assets[col] = s.astype("float32")
    return df_assets

def country_from_hv000(s):
    return s.astype(str).str.extract(r"^([A-Za-z]{2})", expand=False).str.upper()

def mode_numeric(s):
    s = pd.to_numeric(s, errors="coerce")
    return s.mode().iloc[0] if s.notna().any() else np.nan

# --------------- MAIN ---------------
pairs_out = []

dt_dirs = sorted([p for p in glob.glob(os.path.join(BASE, "*HR*DT")) if os.path.isdir(p)])
print(f"Found {len(dt_dirs)} HR/DT folders to process.")

for dt_dir in dt_dirs:
    cc, rnd = parse_cc_round(dt_dir)
    if not cc:
        print(f"Skip {dt_dir}: could not parse country code.")
        continue

    ge_cands = sorted([p for p in glob.glob(os.path.join(BASE, f"{cc}GE*FL")) if os.path.isdir(p)])
    if not ge_cands:
        print(f"No GE folder for {cc}")
        continue
    ge_dirs = [p for p in ge_cands if (rnd and re.search(rf"GE{rnd}[A-Z]*FL", os.path.basename(p)))] or ge_cands

    dta_path = pick_largest(glob.glob(os.path.join(dt_dir, "*.dta")) + glob.glob(os.path.join(dt_dir, "*.DTA")))
    if not dta_path:
        print(f"No DTA file in {dt_dir}")
        continue
    hr = pd.read_stata(dta_path, convert_categoricals=False)
    if "hv001" not in hr.columns:
        print(f"{dt_dir}: missing hv001 in HR file.")
        continue
    if "_cl_" in hr.columns:
        hr = hr.drop(columns=["_cl_"])
    hr["_cl_"] = to_num(hr["hv001"])

    best_ge_dir, best_score, best_ge_df = None, -1, None
    for ge_dir in ge_dirs:
        shp_path = pick_largest(glob.glob(os.path.join(ge_dir, "*.shp")) + glob.glob(os.path.join(ge_dir, "*.SHP")))
        if not shp_path:
            continue
        ge = gpd.read_file(shp_path)
        if "DHSCLUST" not in ge.columns:
            continue
        ge = ge.drop(columns=[c for c in ge.columns if "DHSYEAR" in c.upper()], errors="ignore")
        ge["_cl_"] = to_num(ge["DHSCLUST"])
        hr_cls = set(hr["_cl_"].dropna().unique())
        ge_cls = set(ge["_cl_"].dropna().unique())
        if not hr_cls or not ge_cls:
            continue
        score = len(hr_cls & ge_cls) / max(len(hr_cls), 1)
        if score > best_score:
            best_score = score
            best_ge_dir = ge_dir
            ge_attrs = pd.DataFrame(ge.drop(columns=[ge.geometry.name] if ge.geometry.name in ge.columns else []))
            best_ge_df = ge_attrs.copy()

    if best_ge_dir is None or best_ge_df is None:
        print(f"{dt_dir}: no usable GE shapefile.")
        continue

    if best_ge_df["_cl_"].duplicated().any():
        best_ge_df = best_ge_df.drop_duplicates(subset="_cl_")

    merged = hr.merge(best_ge_df, on="_cl_", how="left", suffixes=("", "_ge"))

    if "hv007" not in merged.columns:
        print(f"{dt_dir}: missing hv007 (year); skipping cluster aggregation.")
        continue

    merged["hv001"] = to_num(merged["hv001"])
    merged["hv007"] = to_num(merged["hv007"])
    merged["country"] = country_from_hv000(merged["hv000"]) if "hv000" in merged.columns else cc

    lat_col = pick_first_present(merged.columns, LAT_CANDS)
    lon_col = pick_first_present(merged.columns, LON_CANDS)
    merged["lat"] = to_num(merged[lat_col]) if lat_col else np.nan
    merged["lon"] = to_num(merged[lon_col]) if lon_col else np.nan

    # --- NEW: Urban/rural variable (1=urban, 2=rural)
    merged["urban_rural"] = to_num(merged.get("hv025", np.nan))

    canon = add_canonical_assets(merged)
    canon = binarize_ownership(canon)

    X_cols = []
    for c in ASSET_CANON:
        s = pd.to_numeric(canon[c], errors="coerce").replace([np.inf, -np.inf], np.nan)
        fill_val = float(s.median()) if s.notna().any() else 0.0
        s = s.fillna(fill_val).astype("float32")
        X_cols.append(s.values)
    X = np.column_stack(X_cols).astype("float32")

    scaler = StandardScaler().fit(X)
    Xs = scaler.transform(X)
    pca = PCA(n_components=1, random_state=0).fit(Xs)
    w = pca.transform(Xs).ravel().astype("float32")
    std_w = float(np.nanstd(w))
    merged["wealth_index_pca"] = (w - np.nanmean(w)) / std_w if std_w > 0 else 0.0

    merged["dhs_wi_factor"]   = to_num(merged.get("hv271", np.nan))
    merged["dhs_wi_quintile"] = pd.to_numeric(merged.get("hv270", np.nan), errors="coerce").astype("Int64")

    needed = merged[["country","hv007","hv001","wealth_index_pca",
                     "dhs_wi_factor","dhs_wi_quintile","lat","lon","urban_rural"]].copy()

    cl = (
        needed.groupby(["country","hv007","hv001"], as_index=False)
              .agg(
                  mean_pca_wealth      = ("wealth_index_pca", "mean"),
                  mean_dhs_wi_factor   = ("dhs_wi_factor",  "mean"),
                  mode_dhs_wi_quintile = ("dhs_wi_quintile", mode_numeric),
                  lat                  = ("lat","mean"),
                  lon                  = ("lon","mean"),
                  n_households         = ("wealth_index_pca", "size"),
                  urban_rural          = ("urban_rural", mode_numeric)
              )
              .rename(columns={"hv007":"year", "hv001":"cluster"})
    )

    cl["urban_rural"] = pd.to_numeric(cl["urban_rural"], errors="coerce").astype("Int64")

    pairs_out.append(cl)

# -------- Assemble one big CSV and drop near-zero coordinates --------
if not pairs_out:
    raise SystemExit("No cluster outputs produced.")

big = pd.concat(pairs_out, ignore_index=True)
near_zero_both = (big["lat"].abs() <= 0.01) & (big["lon"].abs() <= 0.01)
n_removed = int(near_zero_both.sum())
print(f"Rows with near-zero lat&lon removed: {n_removed}")
big = big.loc[~near_zero_both].copy()

totals = (
    big.groupby(["country","cluster"], as_index=False)["n_households"]
       .sum()
       .rename(columns={"n_households":"n_households_cluster_total"})
)
big = big.merge(totals, on=["country","cluster"], how="left")

big.to_csv(OUT_PATH, index=False)
print(f"Final clusters saved -> {OUT_PATH}")
print(big.head(5))
